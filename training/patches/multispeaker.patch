+def _prepared_speakers(prepared_dir: Path) -> tuple[str, ...]:
+    """Ordered voice inventory from dataset.json; empty for a single voice."""
+
+    dataset_path = prepared_dir / "dataset.json"
+    if not dataset_path.is_file():
+        raise ValueError(f"Prepared dataset is missing dataset.json: {dataset_path}")
+    payload = json.loads(dataset_path.read_text(encoding="utf-8"))
+    speakers = payload.get("speakers") or ()
+    if not isinstance(speakers, (list, tuple)):
+        raise ValueError("dataset.json 'speakers' must be a list when present.")
+    if len(speakers) != len(set(speakers)):
+        raise ValueError("dataset.json 'speakers' contains duplicate entries.")
+    return tuple(str(speaker) for speaker in speakers)
