+#: Training checkpoints are named by the step that produced them.
+STEP_CHECKPOINT_PATTERN = re.compile(r"^adaptation-step-(\d+)\.pth$")
+
+
+def prune_training_checkpoints(directory: str | Path, keep: int) -> list[Path]:
+    """Delete all but the newest ``keep`` step checkpoints; return what went.
+
+    Only ``adaptation-step-*.pth`` files are considered. ``latest.pth`` and
+    ``adaptation-final.pth`` do not match the pattern, and the lightweight
+    ``exports/`` packages live in a different directory, so neither is ever
+    touched: this reclaims resume state, never anything needed to choose a
+    final checkpoint. ``keep <= 0`` disables pruning.
+    """
+
+    if keep <= 0:
+        return []
+    root = Path(directory)
+    if not root.is_dir():
+        return []
+    numbered: list[tuple[int, Path]] = []
+    for path in root.glob("adaptation-step-*.pth"):
+        match = STEP_CHECKPOINT_PATTERN.match(path.name)
+        if match:
+            numbered.append((int(match.group(1)), path))
+    numbered.sort(key=lambda item: item[0])
+    removed: list[Path] = []
+    for _, path in numbered[: max(0, len(numbered) - keep)]:
+        try:
+            path.unlink()
+        except OSError:  # a locked or already-removed file must not stop training
+            continue
+        removed.append(path)
+    return removed
+
+
 def copy_checkpoint_alias(source: str | Path, destination: str | Path) -> Path:
     """Atomically refresh a stable checkpoint copy without symlink assumptions."""
 
