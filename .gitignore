# --- Python -----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Tool caches ------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Generated audio --------------------------------------------------------
# Everything the user synthesises lands here. The directory itself is tracked
# so a fresh clone already has somewhere to write.
out/*
!out/.gitkeep

# --- Downloaded artefacts ---------------------------------------------------
# The full English upstream package is only needed for training work. The
# weights themselves are tracked, in model-en/, so a clone speaks both
# languages; this is the complete 38 MB package on top of that. Fetch it with:
#     python training/scripts/download_model.py
training/base-model/

# Hugging Face download bookkeeping, wherever it appears.
.cache/huggingface/

# --- Editors and operating systems ------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
