# --- Python -----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Tool caches ------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Generated audio --------------------------------------------------------
# Everything the user synthesises lands here. The directory itself is tracked
# so a fresh clone already has somewhere to write.
out/*
!out/.gitkeep

# Hugging Face download bookkeeping, wherever it appears.
.cache/huggingface/

# --- Editors and operating systems ------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Browser playground ------------------------------------------------------
# The ONNX export is 38 MB and lives in the Hugging Face Space, not here; the
# repository already carries two checkpoints. Copy it in when working on the
# page locally:
#     cp <export>/onnx/*.onnx web/onnx/
web/onnx/
# onnxruntime-web, served from the page's origin because WebKit refuses a CDN's
# modules in a worker (27 MB). Fetch it with: python tools/fetch_web_runtime.py
web/vendor/
web/node_modules/

# Built by training/stress_frontend/make_hook.py; model/frontend_hook.py is the vendored copy
training/stress_frontend/dist/
